APP_NAME="Saga Menu"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sagamenu
DB_USERNAME=sagamenu
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SAGAMENU_BACKUP_DISK=
SAGAMENU_BACKUP_MAX_AGE_HOURS=26
SAGAMENU_MONITORING_WEBHOOK_URL=
SAGAMENU_SCHEDULER_MAX_AGE_MINUTES=10
SAGAMENU_CLAMAV_ENABLED=false
SAGAMENU_CLAMAV_REQUIRED=false
SAGAMENU_CLAMAV_BINARY=clamscan

# Saga Platform Wave 2. Keep disabled until an immutable SagaMenu source revision
# and environment-scoped service credential have passed review.
SAGAMENU_SAGA_PLATFORM_ENABLED=false
SAGAMENU_SAGA_PLATFORM_BASE_URL=
SAGAMENU_SAGA_PLATFORM_PRODUCT_CODE=sagamenu
SAGAMENU_SAGA_PLATFORM_KEY_ID=
SAGAMENU_SAGA_PLATFORM_HMAC_SECRET=
SAGAMENU_SAGA_PLATFORM_CONTRACT_VERSION=1.0
SAGAMENU_SAGA_PLATFORM_ISSUER=saga-platform
SAGAMENU_SAGA_PLATFORM_AUDIENCE=sagamenu-web
SAGAMENU_SAGA_PLATFORM_PLAN_CODE=
SAGAMENU_SAGA_PLATFORM_TERMS_VERSION=2026-07-16
SAGAMENU_SAGA_PLATFORM_CONNECT_TIMEOUT_SECONDS=3
SAGAMENU_SAGA_PLATFORM_TIMEOUT_SECONDS=10
SAGAMENU_SAGA_PLATFORM_RETRY_ATTEMPTS=3
SAGAMENU_SAGA_PLATFORM_RETRY_DELAY_MILLISECONDS=200
SAGAMENU_SAGA_PLATFORM_ASSERTION_MAX_TTL_SECONDS=300
SAGAMENU_SAGA_PLATFORM_CHECKOUT_PLANS_JSON={}
SAGAMENU_LEGACY_LOGIN_COMPATIBILITY_ENABLED=false
SAGAMENU_LEGACY_LOGIN_COMPATIBILITY_ENDS_AT=

VITE_APP_NAME="${APP_NAME}"
